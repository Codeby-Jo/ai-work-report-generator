{
  "name": "ai-work-tracker",
  "displayName": "AI Work Tracker",
  "publisher": "joshuaraja",
  "repository": {"type": "git", "url": "https://github.com/joshuaraja/ai-work-report"},
  "description": "Tracks VS Code activity for the AI Work Report Generator",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-work-tracker.start",
        "title": "Start AI Work Tracker"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
